+    #[tokio::test]
+    async fn active_lease_status_reports_live_usage_without_touching_settlement() {
+        let state = Arc::new(std::sync::Mutex::new(RetirementMock {
+            usage: 0.5,
+            live_reads: true,
+            ..Default::default()
+        }));
+        let (processor, request, server) = retirement_processor(state.clone(), 0, None).await;
+        let id = &request.client_request_id;
+        // The plain status never calls the issuer.
+        assert_eq!(
+            processor.openrouter_lease_status(id).unwrap().observed_usage_usd,
+            None
+        );
+        assert!(state.lock().unwrap().events.is_empty());
+        let status = processor.openrouter_lease_status_live(id).await.unwrap();
+        assert_eq!(status.status, "active");
+        assert_eq!(status.observed_usage_usd, Some(0.5));
+        assert_eq!(status.usage_usd, None, "settled usage stays unset until retirement");
+        state.lock().unwrap().usage = 0.75;
+        let status = processor.openrouter_lease_status_live(id).await.unwrap();
+        assert_eq!(status.observed_usage_usd, Some(0.75));
+        // An issuer failure leaves the advisory field out instead of failing the status.
+        state.lock().unwrap().fail_usage = true;
+        let status = processor.openrouter_lease_status_live(id).await.unwrap();
+        assert_eq!(status.observed_usage_usd, None);
+        assert_eq!(status.status, "active");
+        assert!(processor.openrouter_lease_status_live("unknown").await.is_none());
+        // Once retired the settled usage is authoritative and nothing is read live.
+        state.lock().unwrap().fail_usage = false;
+        let retired = processor.retire_openrouter_lease(id, &request).await.unwrap();
+        assert_eq!(retired.status, "finalized");
+        let events = state.lock().unwrap().events.len();
+        let status = processor.openrouter_lease_status_live(id).await.unwrap();
+        assert_eq!(status.observed_usage_usd, None);
+        assert_eq!(status.usage_usd, Some(0.75));
+        assert_eq!(state.lock().unwrap().events.len(), events);
+        server.abort();
     }
 
