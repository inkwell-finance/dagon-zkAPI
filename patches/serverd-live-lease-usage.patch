+    /// Like [`Self::openrouter_lease_status`], and for a still-active direct OpenRouter key also the issuer's current usage
+    /// reading. Clients poll this to settle early once a key is exhausted or idle; the read is advisory and a failure leaves
+    /// the field out. Settlement itself never uses it.
+    pub async fn openrouter_lease_status_live(
+        &self,
+        client_request_id: &str,
+    ) -> Option<OpenRouterLeaseStatusResponse> {
+        let lease = self.store.lookup_openrouter_lease(client_request_id)?;
+        let mut status = self.openrouter_lease_status(client_request_id)?;
+        if lease.status == "active" && lease.key_source == "openrouter" {
+            if let (Some(provisioner), Some(key_hash)) =
+                (self.openrouter.as_ref(), lease.key_hash.as_deref())
+            {
+                if let Ok(usage) = provisioner.get_key_usage(key_hash).await {
+                    status.observed_usage_usd = Some(usage.usage_usd);
+                }
+            }
+        }
+        Some(status)
     }
 
