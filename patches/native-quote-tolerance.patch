+#[derive(Clone)]
+struct LiveRpc {
+    accounts: Arc<std::sync::Mutex<HashMap<String, Value>>>,
+    genesis: String,
+}
+async fn live_rpc(State(state): State<LiveRpc>, Json(request): Json<Value>) -> Json<Value> {
+    let result = match request["method"].as_str().unwrap() {
+        "getGenesisHash" => json!(state.genesis),
+        "getAccountInfo" => {
+            let value = state
+                .accounts
+                .lock()
+                .unwrap()
+                .get(request["params"][0].as_str().unwrap())
+                .cloned()
+                .unwrap_or(Value::Null);
+            json!({"context":{"slot":100},"value":value})
+        }
+        other => panic!("unexpected RPC {other}"),
+    };
+    Json(json!({"jsonrpc":"2.0","id":1,"result":result}))
+}
