+#[tokio::test]
+async fn quote_older_than_latest_is_accepted_within_tolerance_and_otherwise_retriably_stale() {
+    use zkapi_serverd::error::ServerError;
+    let dir = tempfile::tempdir().unwrap();
+    let mut f = Fixture::new(dir.path().join("unused.db").to_string_lossy().into_owned());
+    f.serialize_accounts();
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    f.config.solana.as_mut().unwrap().ledger.rpc_url =
+        format!("http://{}", listener.local_addr().unwrap());
+    let accounts = Arc::new(std::sync::Mutex::new(f.accounts.clone()));
+    let router = Router::new().route("/", post(live_rpc)).with_state(LiveRpc {
+        accounts: accounts.clone(),
+        genesis: f.genesis.clone(),
+    });
+    let task = tokio::spawn(async move { axum::serve(listener, router).await.unwrap() });
+    let price_account = f.config.solana.as_ref().unwrap().billing.price_account.clone();
+    // Publish a newer finalized price: (price, conf, publish_time delta, slot).
+    let publish = |price: i64, conf: u64, seconds: i64, slot: u64| {
+        let mut update = f.price.clone();
+        update.price_message.price = price;
+        update.price_message.conf = conf;
+        update.price_message.publish_time += seconds;
+        update.posted_slot = slot;
+        let mut data = Vec::new();
+        update.try_serialize(&mut data).unwrap();
+        data.resize(PriceUpdateV2::LEN, 0);
+        accounts
+            .lock()
+            .unwrap()
+            .insert(price_account.clone(), account(PriceUpdateV2::owner(), false, data));
+    };
+    let signer = ServerSigner::new(&f.config.state_seed, &f.config.clear_seed);
+    let backends = prepare_solana_backends(&f.config, &signer).await.unwrap();
+    let quote = backends.billing.quote(now()).await.unwrap();
+    backends.billing.validate(&quote, now()).await.unwrap();
+
+    // A newer publication within 50 bps (and any rise) leaves the older proof-bound quote valid.
+    publish(14_990_000_000, 15_000_000, 1, 11);
+    backends.billing.validate(&quote, now()).await.unwrap();
+    publish(15_500_000_000, 15_000_000, 2, 12);
+    backends.billing.validate(&quote, now()).await.unwrap();
+    // A forged quote that only lies within tolerance of the latest was never read by this server.
+    let BillingQuote::NativeSol(sol) = &quote else { panic!("expected SOL") };
+    let mut forged = sol.clone();
+    forged.price = "15400000000".into();
+    assert!(matches!(
+        backends.billing.validate(&BillingQuote::NativeSol(forged), now()).await,
+        Err(ServerError::NativeQuoteStale)
+    ));
+    // A fall beyond tolerance is retriably stale, never silently priced at the old quote.
+    publish(14_800_000_000, 15_000_000, 3, 13);
+    let error = backends.billing.validate(&quote, now()).await.unwrap_err();
+    assert!(matches!(error, ServerError::NativeQuoteStale), "{error:?}");
+    assert!(error.is_retriable());
+    // A fresh quote taken after the move validates again.
+    let fresh = backends.billing.quote(now()).await.unwrap();
+    backends.billing.validate(&fresh, now()).await.unwrap();
+    // The quoted publication must still be within the max price age.
+    assert!(matches!(
+        backends.billing.validate(&quote, now() + 31).await,
+        Err(ServerError::NativeQuoteExpired)
+    ));
+    task.abort();
+}
