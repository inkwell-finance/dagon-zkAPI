+/// The proof binds `quoted`, and its price alone sizes the lease budget and the
+/// settlement conversion, so serverd verifies against it rather than rewriting
+/// it. A fall of the latest finalized lower bound (price - confidence, the
+/// price billing uses) is the only move that can under-collateralise the
+/// server, so it alone is capped by `tolerance_bps`; a rise only favours it.
+/// The quote's own freshness is enforced by the caller.
+pub(crate) fn assess_quote_against_latest(
+    quoted: &SolanaBillingQuote,
+    latest: &SolanaBillingQuote,
+    tolerance_bps: u16,
+) -> Result<(), ServerError> {
+    if quoted == latest {
+        return Ok(());
+    }
+    if latest.publish_time < quoted.publish_time
+        || latest.posted_slot < quoted.posted_slot
+        || latest.exponent != quoted.exponent
+    {
+        return Err(ServerError::NativeQuoteStale);
+    }
+    let lower = |quote: &SolanaBillingQuote| -> Result<u128, ServerError> {
+        let price: u64 = quote.price.parse().map_err(|_| invalid("invalid SOL price"))?;
+        let confidence: u64 = quote
+            .confidence
+            .parse()
+            .map_err(|_| invalid("invalid SOL confidence"))?;
+        price
+            .checked_sub(confidence)
+            .filter(|value| *value > 0)
+            .map(u128::from)
+            .ok_or_else(|| invalid("SOL lower-bound price must be positive"))
+    };
+    let (quoted_lower, latest_lower) = (lower(quoted)?, lower(latest)?);
+    // latest_lower < quoted_lower * (1 - tolerance), in exact integers.
+    if latest_lower * 10_000 < quoted_lower * (10_000 - u128::from(tolerance_bps)) {
+        return Err(ServerError::NativeQuoteStale);
+    }
+    Ok(())
+}
