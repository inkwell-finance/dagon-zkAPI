+        // A 50 bps fall of the lower bound passes a 50 bps tolerance; 51 bps does not.
+        // Exact lower-bound fall: 14_999_000_000 * (10_000 - bps) / 10_000 plus the same confidence.
+        let fall = |bps: u64| quote(14_999_000_000 * (10_000 - bps) / 10_000 + 1_000_000, 1_000_000, 1_001, 11);
+        assess(&fall(49), 50).unwrap();
+        assess(&fall(50), 50).unwrap();
+        assert!(matches!(assess(&fall(51), 50), Err(ServerError::NativeQuoteStale)));
