+        let assess = |latest: &SolanaBillingQuote, bps| assess_quote_against_latest(&quoted, latest, bps);
+        assess(&quoted, 0).unwrap();
+        // A newer publication at the same price, or any rise, favours the server.
+        assess(&quote(15_000_000_000, 1_000_000, 1_001, 11), 0).unwrap();
