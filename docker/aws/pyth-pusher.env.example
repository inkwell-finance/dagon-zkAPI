# Keep this file mode 0600. Feed, shard, programs and the push cadence come
# from the compiled shared profile; only secrets and endpoints are set here.
#
# Hermes API key (Pyth Terminal). Sent only as an Authorization: Bearer header
# and never passed on the command line.
PYTH_HERMES_API_KEY=REPLACE_WITH_HERMES_API_KEY
# Dedicated fee payer for pushes; mode 0600, mounted read-only from the
# operator config directory. Not the vault authority, treasury, challenger or
# any user wallet. Fund it (see docs/SOLANA_SERVER.md, "Operator Pyth pusher").
ZKAPI_PYTH_PUSHER_KEYPAIR=/run/dagon-zkapi/pyth-pusher-keypair.json
# Optional: a dedicated RPC with sendTransaction and confirmed/finalized reads.
# SOLANA_RPC_URL=REPLACE_WITH_SOLANA_RPC_URL
# Optional: Hermes endpoint (default https://hermes.pyth.network; Pyth also
# serves https://pyth.dourolabs.app/hermes).
# PYTH_HERMES_URL=https://hermes.pyth.network
# Optional: compute-unit price of each push packet (default 10000).
# ZKAPI_PYTH_PUSHER_PRIORITY_FEE_MICRO_LAMPORTS=10000
# Optional: protected payer reserve; new payments must leave this balance (default 2 SOL).
# ZKAPI_PYTH_PUSHER_MIN_BALANCE_LAMPORTS=2000000000
