# Keep this file mode 0600. The keypair file is mounted read-only from the
# operator config directory to /run/dagon-zkapi by compose.yml.
ZKAPI_CHALLENGE_SOLANA_KEYPAIR=/run/dagon-zkapi/challenge-keypair.json
