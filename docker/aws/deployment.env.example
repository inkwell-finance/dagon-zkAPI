# Public Dagon zkAPI deployment settings. Shared protocol parameters (program
# id, circuit, USDC asset, vault policy, server timing) are compiled into the
# binaries and cannot be set here.
RUST_LOG=info

# Finalized-read Solana RPC endpoint. indexer.env and challenge.env may
# override it with dedicated endpoints.
SOLANA_RPC_URL=REPLACE_WITH_FINALIZED_SOLANA_RPC_URL

# Network identity file (genesis hash, vault authority/state, treasury USDC
# token account; the operator creates that classic-Token USDC account before
# initializing the vault). The image ships
# solana/profile/mainnet-beta.identity.json at
# /srv/zkapi/solana/profile/mainnet-beta.identity.json and uses it by default.
# Override only with a file produced by `dagon-zkapi-deploy identity` that is
# bind-mounted read-only into the containers (see README.md).
# ZKAPI_SOLANA_IDENTITY=/run/dagon-zkapi-identity/identity.json

# Set only for verifier-backed OA-org leases. This is mutually exclusive with
# a direct OpenRouter management credential in server.env.
# OA_ORG_URL=https://org.example
