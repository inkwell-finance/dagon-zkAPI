# Public Dagon zkAPI Solana deployment metadata. Replace every placeholder.
LEDGER_BACKEND=solana
CIRCUIT_ID=zkapi-v2-concession-v1
REQUEST_CHARGE_CAP=50000
LEASE_TTL_SECONDS=300
SETTLEMENT_GRACE_SECONDS=5
SETTLEMENT_POLL_SECONDS=2
RUST_LOG=info

# Immutable Solana deployment identity. The server derives the protocol chain
# ID and deployment binding from these values; do not supply EVM identities.
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=REPLACE_WITH_FINALIZED_SOLANA_RPC_URL
SOLANA_PROGRAM_ID=REPLACE_WITH_IMMUTABLE_PROGRAM_ID
SOLANA_VAULT_STATE=REPLACE_WITH_VAULT_STATE_PDA
SOLANA_GENESIS_HASH=REPLACE_WITH_CLUSTER_GENESIS_HASH

# Pyth SOL/USD source pinned by the selected deployment. The receiver/feed
# defaults are shown explicitly so an operator can audit all trust pins.
PYTH_PRICE_ACCOUNT=REPLACE_WITH_PYTH_SOL_USD_PRICE_UPDATE_ACCOUNT
PYTH_RECEIVER_PROGRAM=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ
PYTH_FEED_ID=0xef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
PYTH_MAX_AGE_SECONDS=30
PYTH_MAX_CONFIDENCE_BPS=100

# Set only for verifier-backed OA-org leases. This is mutually exclusive with
# a direct OpenRouter management credential in server.env.
# OA_ORG_URL=https://org.example
